# ElizaOS Environment Configuration Template
# 
# This template is copied and modified by the Docker containers based on the target:
# - Development: Enables debug logging, UI, uses PGLite by default
# - Production: Enables info logging, disables UI, requires PostgreSQL
# 
# 💡 USER CUSTOMIZATION:
# Create docker/.env.local to override any settings:
# 
# cat > docker/.env.local << EOF
# OPENAI_API_KEY=sk-your-key
# ANTHROPIC_API_KEY=sk-ant-your-key  
# EOF

# ================================
# AI Provider Configuration
# ================================
# At least one AI provider is required

# OpenAI (Primary recommendation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Other providers (optional)
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
XAI_API_KEY=your_xai_api_key_here

# ================================
# Database Configuration
# ================================
# Leave empty to use built-in PGLite (good for development)
# Set to PostgreSQL URL for production deployments
POSTGRES_URL=

# ================================
# ElizaOS Configuration
# ================================
# Server authentication (recommended for production)
ELIZA_SERVER_AUTH_TOKEN=

# UI Configuration (modified by target)
ELIZA_UI_ENABLE=true

# Logging (modified by target)
LOG_LEVEL=info

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# ================================
# Environment Settings
# ================================
# These are set automatically by containers based on target
NODE_ENV=production
DEV_MODE=false
WATCH_MODE=false

# ================================
# Platform Integrations (Optional)
# ================================
# Discord Integration
DISCORD_API_TOKEN=

# Twitter/X Integration  
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Telegram Integration
TELEGRAM_BOT_TOKEN=

# ================================
# Performance & Security (Production)
# ================================
# CORS Configuration
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Memory and performance
MAX_MEMORY_USAGE=2048
WORKER_THREADS=4
CACHE_TTL=3600

# Health checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ================================
# Monitoring (Optional)
# ================================
# Error tracking
SENTRY_DSN=

# Performance monitoring
OPENTELEMETRY_ENDPOINT=