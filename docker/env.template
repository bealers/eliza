## Opinionated configuration for elizaOS Docker deployments
## Each target will set its own defaults
## create docker/.env.local to override anything you need to set for any target

####################################
#### Core Configuration ####
####################################

# Environment and logging
NODE_ENV=production
LOG_LEVEL=info

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# Express Configuration
EXPRESS_MAX_PAYLOAD=2mb

# Controls whether the web UI is available
# Set to "true" to force enable, "false" to force disable
# Default: enabled in development, disabled in production
ELIZA_UI_ENABLE=false

# API Auth access
# REQUIRED for production! All /api/* routes require X-API-KEY header with this value
ELIZA_SERVER_AUTH_TOKEN=

####################################
#### Database Configuration ####
####################################

# External PostgreSQL (recommended for production)
#POSTGRES_URL=postgresql://username:password@hostname:5432/database_name

# Alternative: PGLite for local development/testing
#PGLITE_DATA_DIR=/app/data

####################################
#### AI Model Providers ####
####################################

# OpenAI (required for embeddings)
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

####################################
#### Agent Configuration ####
####################################

# Cache TTL in seconds
CACHE_TTL=3600

####################################
#### Production Features ####
####################################

# Monitoring and Observability
#SENTRY_DSN=
#OPENTELEMETRY_ENDPOINT=

# Security Configuration
CORS_ORIGIN=*
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Performance Configuration
MAX_MEMORY_USAGE=2048
WORKER_THREADS=4

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000